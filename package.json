{
  "name": "viewdeck",
  "productName": "ViewDeck",
  "version": "0.2.0",
  "private": true,
  "description": "Free, open-source, keyboard-first database GUI for PostgreSQL, Amazon RDS and Aurora: AWS SSO, IAM auth and SSM tunnels built in.",
  "keywords": [
    "database",
    "database-gui",
    "sql-client",
    "postgresql",
    "postgres",
    "aws",
    "rds",
    "aurora",
    "ssm",
    "iam-authentication",
    "electron",
    "developer-tools"
  ],
  "homepage": "https://github.com/Adityagaddhyan/viewdeck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adityagaddhyan/viewdeck.git"
  },
  "bugs": {
    "url": "https://github.com/Adityagaddhyan/viewdeck/issues"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --mac --publish never",
    "dist:dir": "npm run build && electron-builder --mac --dir --publish never",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "install-electron && node scripts/brand-dev-electron.mjs",
    "test:integration": "scripts/start-test-postgres.sh vitest run src/main/drivers",
    "test:e2e": "npm run build && scripts/start-test-postgres.sh node e2e/smoke.e2e.mjs",
    "gen:monaco": "node scripts/gen-monaco-lean.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "npm run typecheck && npm test && npm run check:docs",
    "brand:electron": "node scripts/brand-dev-electron.mjs",
    "gen:icon": "electron scripts/render-icon.cjs resources/icon.svg resources/icon.png 1024",
    "demo:gif": "npm run build && scripts/start-test-postgres.sh node scripts/record-demo.mjs"
  },
  "devDependencies": {
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "3.14.28",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "elkjs": "0.12.1",
    "lucide-react": "1.78.0",
    "monaco-editor": "0.57.0",
    "playwright-core": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "3.1175.0",
    "@aws-sdk/client-rds": "3.1175.0",
    "@aws-sdk/client-ssm": "3.1175.0",
    "@aws-sdk/client-sts": "3.1175.0",
    "@aws-sdk/credential-providers": "3.1175.0",
    "@aws-sdk/rds-signer": "3.1175.0",
    "@aws-sdk/types": "3.975.1",
    "pg": "8.23.1"
  },
  "author": "ViewDeck",
  "license": "MIT"
}
